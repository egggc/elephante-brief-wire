# Elephante Brief configuration. Copy to .env and edit (or run node scripts/init-env.ts, which writes .env with random secrets).
# The web front end only gets the site address; every secret stays in the backend. Never commit .env to Git.

# ===== Required =====

# The site's public address: generated links, RSS, share cards and MCP all use it. Keep this for a local trial.
SITE_URL=http://localhost:3000

# Admin password (at least 12 characters), for logging in at /admin.
ADMIN_PASSWORD=

# Secrets for session signing and image proxy signing: a random string each (openssl rand -hex 32).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Database password under Docker (the database port is not exposed; still use a random string).
POSTGRES_PASSWORD=

# Model: any OpenAI-compatible API works and every step uses it by default. Elephante Brief uses
# MiniMax M2.5 through OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=minimax/minimax-m2.5
# Provider-specific request fields (JSON). MiniMax M2.5 always reasons; OpenRouter keeps the reasoning out of the answer:
LLM_EXTRA_JSON={"reasoning":{"exclude":true}}
# Output tokens reserved for the reasoning, added to every step's own limit. Without it the reasoning can use up
# the output budget and the answer comes back empty ("output token limit reached (finish_reason=length)").
LLM_REASONING_TOKENS=4000
# Turn on if the model can read images (selected items' headlines then also look at the first image):
# LLM_VISION=true
# Turn off if the service does not support JSON mode (response_format):
# LLM_JSON_MODE=false

# ===== Optional: better event grouping =====

# Vector recall: any OpenAI-compatible /embeddings endpoint. Without it grouping finds candidates by word overlap,
# but discussion posts used only as heat evidence (hot_signal sources) mostly won't attach to events.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# Or set only an Alibaba Cloud Model Studio key to use text-embedding-v4:
# DASHSCOPE_API_KEY=
# Vector dimensions (EMBEDDING_* default to what the service returns; Model Studio defaults to 1024). Changing it recomputes old vectors:
# EMBEDDING_DIMS=

# ===== Optional: a different model per step =====
# Every step uses LLM_* above by default. To use another provider for one step, give a preset name (needs that key):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# Preset names and the keys they need (site/models.ts):
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# Note: with DASHSCOPE_API_KEY set and no EMBEDDING_API_KEY, grouping uses Model Studio vectors (text-embedding-v4), billed separately.

# ===== Optional: paid collection services (billed per request, with a budget breaker in the admin settings) =====
# X (Twitter) accounts: SocialData
# SOCIALDATA_API_KEY=
# WeChat official accounts: Dajiala
# DAJIALA_KEY=
# Browser-rendered fallback when a page body can't be fetched: Jina Reader
# JINA_API_KEY=

# ===== Optional: Feishu =====
# Push selected items to a Feishu group (only T1 and T1_5 sources): enable under admin Settings → Destinations; webhooks here.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# Alerts and feedback to an internal Feishu group (needs a Feishu custom app):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# Log in to the admin with a Feishu account (optional, alongside the admin password):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== Optional: other =====
# Sent with JSON sources that read the GitHub API (api.github.com) for a higher quota; read-only is enough:
# GITHUB_TOKEN=
# Token for external scripts pushing content (POST /api/ingest/items), at least 16 characters; unset turns the endpoint off.
# INGEST_TOKEN=
# Pushes per client per minute (docker compose defaults to 10); 0 when a reverse proxy already limits:
# INGEST_RATE_LIMIT=10
# A proxy for fetching sources (e.g. a server that can't reach some sites directly):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# Image proxy upstream traffic limits (MB per minute, GB per day); unset uses DEPLOYMENT.imageUpstreamBudget in site/site.ts (no limit):
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# true when Caddy or Nginx sits in front, so visitor addresses are read from X-Forwarded-For;
# keep false when the site faces the internet directly, so nobody can forge an address to dodge login and feedback limits.
TRUST_PROXY=false
# MCP accepts only requests to the SITE_URL host (and localhost); list other hosts here, comma-separated:
# MCP_ALLOWED_HOSTS=
# Minutes without new content before the "stopped collecting" alert; unset uses ALERTS.quietMinutes in site/site.ts (360):
# ALERT_QUIET_MINUTES=360
# Submit new pages to IndexNow (Bing and others) daily; the key is 32 hex characters you generate:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# Daily database backups to S3-compatible storage (AWS S3, Tencent COS, Alibaba OSS…).
# Without DB_BACKUP_STORE_DOMAIN the address is built Tencent COS style (<bucket>.cos.<region>.myqcloud.com);
# for others give the bucket's domain, e.g. my-bucket.s3.us-east-1.amazonaws.com:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# Log level (default info) and database pool size (default 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# Release name, shown on the admin "Runs" page and /api/health so you can confirm an upgrade took:
# AIHOT_RELEASE=
# Environment name, production or development by NODE_ENV; non-production alerts carry it, and dev login works only outside production:
# AIHOT_ENVIRONMENT=
# Keep secrets in grouped files in one directory (models.env, collectors.env, integrations.env, auth.env) instead of here; values here win:
# AIHOT_CREDENTIALS_DIR=

# ===== Safety valves =====
# Sources are fetched (including the daily source icons) and models called only when these are true; remove or set false to stop both.
# Every *_ENABLED switch in this file accepts only true: 1, yes or TRUE count as off.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Only when running directly on the machine, without Docker =====
# DATABASE_URL=postgres://user@127.0.0.1:5432/elephante
# API_BASE_URL=http://127.0.0.1:3001
# Where uploads, image cache and local backups go (default .data in the repository):
# AIHOT_DATA_DIR=/var/lib/elephante
# Skip login to the admin in development (production refuses to start with it), and the admin display name:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# Allow fetching private network addresses for local debugging (default off; production refuses to start):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== With docker compose --profile https =====
# SITE_DOMAIN=example.com
# The port the site opens on this machine (docker compose, default 3000 on all interfaces); behind HTTPS only for the local Caddy:
# PORT=127.0.0.1:3000
# Also set TRUST_PROXY above to true.
